# Convex — set by `npx convex dev` (writes .env.local automatically).
# The public URL the browser client connects to.
NEXT_PUBLIC_CONVEX_URL=

# ---------------------------------------------------------------------------
# Magic-link auth (M1 / #16, M1a / #33).
#
# These are read by Convex functions, so they are set as *Convex* environment
# variables, not in this file.
#
# For **dev** deployments you do not set them by hand. Four of them —
# JWT_PRIVATE_KEY, JWKS, AUTH_EMAIL_TRANSPORT, AUTH_EMAIL_FROM — are the
# project's *default environment variables* for the `dev` deployment type
# (#73), so every newly created dev deployment (cloud or local) imports them at
# creation and can complete a sign-in immediately:
#
#   npx convex env default list --type dev     # what a new dev deployment gets
#
# Defaults apply only at creation and are not synced afterwards, so an existing
# deployment has to be updated with `npx convex env set`. SITE_URL is
# deliberately *not* a default — see below.
#
# Listed here so the required configuration is discoverable in one place; see
# docs/deploy/auth-env.md for the per-tier values and how to reproduce them.
# ---------------------------------------------------------------------------

# How the magic link reaches the user: `console` | `resend`.
# `console` writes the link to the server log instead of sending it, so any
# address (alice@example.com) can sign in locally with no domain and no inbox.
# Defaults to `console` when unset — production must set `resend` explicitly.
# Seeded on dev deployments from the project defaults as `console`.
# AUTH_EMAIL_TRANSPORT=console

# The sender address. Never hardcoded, so completing #22 is a config change:
#   onboarding@resend.dev   — today (Resend's shared sender; only delivers to
#                             the Resend account holder's own address)
#   noreply@<your-domain>   — once #22 verifies a sending domain
# Seeded on dev deployments from the project defaults.
# AUTH_EMAIL_FROM=onboarding@resend.dev

# Required only by the `resend` transport. The real key is set as a Convex
# environment variable (`npx convex env set`), never committed, and is *not* a
# project default — the dev default transport is `console`, which needs no key.
# RESEND_API_KEY=

# Convex-side auth secrets, set as *Convex* env vars, not in this file. The
# RS256 key pair Convex Auth signs session tokens with. Dev deployments share
# one keypair, seeded from the project defaults; prod has its own.
# JWT_PRIVATE_KEY=
# JWKS=

# The site origin the magic link points at — must match where the browser app
# runs, since the link is opened there and the code is exchanged for a session.
# Read by the auth backend; set it as a Convex env var.
#
# Deliberately NOT a project default: it has to match the Next dev origin of
# whichever worktree is running, so it is the one auth var a new dev deployment
# still has to be told about.
# SITE_URL=http://localhost:3000

# Note: the browser session (#39) also requires `convex/auth.config.ts`, which
# declares the JWT issuer (CONVEX_SITE_URL) so the deployment trusts the token
# the client presents. It is committed, not configured here.
