# Convex — set by `npx convex dev` (writes .env.local automatically).
# The public URL the browser client connects to.
NEXT_PUBLIC_CONVEX_URL=

# ---------------------------------------------------------------------------
# Magic-link auth (M1 / #16, M1a / #33).
#
# These are read by Convex functions, so they are set as *Convex* environment
# variables, not in this file:
#
#   npx convex env set AUTH_EMAIL_TRANSPORT console
#   npx convex env set AUTH_EMAIL_FROM onboarding@resend.dev
#
# Listed here so the required configuration is discoverable in one place.
# ---------------------------------------------------------------------------

# How the magic link reaches the user: `console` | `resend`.
# `console` writes the link to the server log instead of sending it, so any
# address (alice@example.com) can sign in locally with no domain and no inbox.
# Defaults to `console` when unset — production must set `resend` explicitly.
# AUTH_EMAIL_TRANSPORT=console

# The sender address. Never hardcoded, so completing #22 is a config change:
#   onboarding@resend.dev   — today (Resend's shared sender; only delivers to
#                             the Resend account holder's own address)
#   noreply@<your-domain>   — once #22 verifies a sending domain
# AUTH_EMAIL_FROM=onboarding@resend.dev

# Required only by the `resend` transport. The real key is set as a Convex
# environment variable (`npx convex env set`), never committed.
# RESEND_API_KEY=

# Set automatically by `npx @convex-dev/auth`: the RS256 key pair Convex Auth
# signs session tokens with, plus the site origin the magic link points at.
# JWT_PRIVATE_KEY=
# JWKS=
# SITE_URL=http://localhost:3000
